# Stayzy Mobile Environment Variables (Expo SDK 52)
# Prefix variables with EXPO_PUBLIC_ for client-side access

# Backend REST API Server Target (Preferred format includes /api/v1):
# - Android Emulator (with Express running on host PC): http://10.0.2.2:5000/api/v1
# - Physical Android / iOS Device (same Wi-Fi): http://<YOUR_PC_LAN_IP>:5000/api/v1
# - Web Preview / Localhost: http://localhost:5000/api/v1
# - Production (HTTPS required): https://api.stayzy.example.com/api/v1
EXPO_PUBLIC_API_URL="http://10.0.2.2:5000/api/v1"

# Stayzy Website URL loaded by the Android WebView shell
# Local emulator test default: http://10.0.2.2:3012
# Production MUST use the deployed HTTPS website URL (never localhost or 10.0.2.2)
EXPO_PUBLIC_WEB_APP_URL="http://10.0.2.2:3012"

# Shared Firebase Project (stayzy-2e171 — must match website & backend FIREBASE_WEB_API_KEY)
EXPO_PUBLIC_FIREBASE_API_KEY=
EXPO_PUBLIC_FIREBASE_AUTH_DOMAIN=stayzy-2e171.firebaseapp.com
EXPO_PUBLIC_FIREBASE_PROJECT_ID=stayzy-2e171
EXPO_PUBLIC_FIREBASE_STORAGE_BUCKET=stayzy-2e171.firebasestorage.app
EXPO_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=54975315748
EXPO_PUBLIC_FIREBASE_APP_ID=

# Google OAuth Client IDs (from Google Cloud / Firebase project stayzy-2e171)
EXPO_PUBLIC_GOOGLE_WEB_CLIENT_ID=
EXPO_PUBLIC_GOOGLE_ANDROID_CLIENT_ID=
