NODE_ENV=development
PORT=5000
API_PREFIX=/api/v1

# Security & Authentication (Backend-only: NEVER expose in frontend code)
JWT_SECRET=your_jwt_secret_minimum_32_characters_long
JWT_EXPIRES_IN=1d

# CORS (comma-separated origins for Laptop A, Laptop B, and production domains)
CORS_ORIGIN=http://localhost:3000,http://127.0.0.1:3000

# PostgreSQL Database Configuration (Central shared database)
# Option 1: Single connection string (recommended for hosted Neon / Supabase / Render / Railway Postgres)
# DATABASE_URL=postgresql://postgres:your_database_password@your-db-host:5432/stayzy_dev
# DB_SSL=true

# Option 2: Individual parameters (local or LAN PostgreSQL)
DB_HOST=localhost
DB_PORT=5432
DB_NAME=stayzy_dev
DB_USER=postgres
DB_PASSWORD=your_database_password
DB_POOL_MAX=20
DB_IDLE_TIMEOUT_MS=30000
DB_CONNECTION_TIMEOUT_MS=5000

# Razorpay Payment Gateway (Test keys for dev/test, Live keys for production)
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=
